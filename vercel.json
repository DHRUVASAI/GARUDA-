{
  "version": 2,
  "name": "garuda-x",
  "builds": [
    {
      "src": "garuda_backend.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "garuda_backend.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
