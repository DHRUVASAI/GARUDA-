# Copy to .env and adjust. On Windows PowerShell: Get-Content .env.example | Set-Content .env

# Flask
GARUDA_HOST=0.0.0.0
GARUDA_PORT=5000
GARUDA_DEBUG=false
GARUDA_THREADED=true
GARUDA_LOG_LEVEL=INFO

# Database
GARUDA_DB_PATH=garuda.db
GARUDA_SCAN_RETENTION_DAYS=30
GARUDA_ALERT_COOLDOWN_SEC=300

# ARP spoof false-positive controls (optional)
# GARUDA_DHCP_VOLATILE_RANGE=192.168.1.100-200
GARUDA_ARP_OLD_MAC_MIN_SEC=300
GARUDA_ARP_NEW_MAC_MIN_SIGHTINGS=2

# Port scan TCP timeouts (milliseconds); critical ports (22,80,443,3389,445) use max(RTT-based, floor)
GARUDA_PORT_TIMEOUT_FAST_MS=400
GARUDA_PORT_TIMEOUT_MED_MS=700
GARUDA_PORT_TIMEOUT_SLOW_MS=1200
GARUDA_PORT_CRITICAL_FLOOR_MS=1000

# Background monitor (monitor.py)
GARUDA_MONITOR_SCAN_INTERVAL=300
GARUDA_MONITOR_ARP_INTERVAL=30

# API rate limits (Flask-Limiter syntax)
GARUDA_RATE_SCAN_FULL=8 per minute
GARUDA_RATE_SCAN_CONNECTED=30 per minute

# Optional: override default Content-Security-Policy string
# GARUDA_CSP=default-src 'self'; ...
