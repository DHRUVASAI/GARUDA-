# ==============================================================================
# GARUDA v4 — Full-Stack Network Guardian & Web3 Merkle Ledger Configuration
# ==============================================================================

# Core Engine Settings
GARUDA_SCAN_INTERVAL=15
GARUDA_SIMULATION_MODE=false
# GARUDA_DB_URL=sqlite:///data/garuda_v4.db

# Optional EVM On-Chain Anchoring (Defaults to Monad Testnet)
GARUDA_WEB3_RPC_URL=https://testnet-rpc.monad.xyz/
GARUDA_WEB3_CHAIN_NAME=Monad Testnet
GARUDA_WEB3_CONTRACT=0x1014300000000000000000000000000000000001
# Set your hex private key to enable on-chain broadcasting of Merkle roots:
# GARUDA_WEB3_PRIVATE_KEY=0x...
