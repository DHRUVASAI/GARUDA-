# Copy to .env and fill in real values before running docker compose up -d
POSTGRES_USER=garuda
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=garuda_prod

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GARUDA_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=720
GARUDA_REQUIRE_AUTH=true

# Comma-separated frontend origins (e.g. https://garuda.yourdomain.com,http://localhost:8000)
ALLOWED_ORIGINS=*

# Optional: auto-create initial admin account on first boot
GARUDA_ADMIN_USER=admin
GARUDA_ADMIN_EMAIL=admin@garuda.local
GARUDA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# AWS Settings (prefer EC2 IAM Role in production; never commit real keys to Git)
AWS_REGION=us-east-1
